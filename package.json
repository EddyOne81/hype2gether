{
  "name": "hype2gether",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint . && pnpm --filter @hype2gether/mobile lint && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "prepare": "lefthook install",
    "gen:types": "node scripts/gen-types.mjs",
    "test:db": "supabase test db",
    "db:start": "supabase start -x studio,imgproxy,mailpit,logflare,vector,supavisor,edge-runtime",
    "db:stop": "supabase stop --no-backup"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "~3.9.10",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}

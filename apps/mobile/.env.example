# Copy to .env and fill in locally (never commit .env). In EAS builds these come from EAS environment variables.
# Everything prefixed EXPO_PUBLIC_ is shipped inside the app and readable by anyone: public values only.
# Never put the Supabase secret / service role key here.

# development | preview | production
EXPO_PUBLIC_APP_ENV=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

{
  "name": "@hype2gether/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Generated DB types, zod contracts for Edge Functions, and shared constants. No secrets, no env access.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.types.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
